+// Append-only, line-oriented diagnostic log. A timestamp is written to each event.
+// Avoid storing user filenames in the log; checkpoint database itself already holds paths.
+// Unix milliseconds are unambiguous and can be converted to local time in a later GUI view.
+fn record_event(database: &Path, event: &str, details: &str) {
+    let timestamp_ms = SystemTime::now().duration_since(UNIX_EPOCH)
+        .map(|value| value.as_millis()).unwrap_or_default();
+    let log_path = database.with_file_name("duplicate_checkpoint_events.log");
+    if let Ok(mut file) = OpenOptions::new().create(true).append(true).open(log_path) {
+        let _ = writeln!(file, "{timestamp_ms}\t{event}\t{details}");
+    }
+}
