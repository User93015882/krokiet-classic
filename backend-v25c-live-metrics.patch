@@ -15,6 +15,43 @@ use crate::common::config_cache_path::get_config_cache_path;
 use crate::common::model::HashType;
 use crate::tools::duplicate::DuplicateEntry;
 
+// In-process, stage-scoped counters. SQLite is still the durable source of checksums.
+// No file paths are retained here and no filesystem polling is required by the GUI.
+use std::sync::atomic::{AtomicBool, AtomicU64, Ordering};
+static METRICS_VALID: AtomicBool = AtomicBool::new(false);
+static LEGACY_HITS: AtomicU64 = AtomicU64::new(0);
+static SQLITE_HITS: AtomicU64 = AtomicU64::new(0);
+static HASH_MISSES: AtomicU64 = AtomicU64::new(0);
+static PENDING_BYTES: AtomicU64 = AtomicU64::new(0);
+static COMMITTED_FILES: AtomicU64 = AtomicU64::new(0);
+static COMMITTED_BATCHES: AtomicU64 = AtomicU64::new(0);
+
+pub(super) fn clear_live_metrics() {
+    METRICS_VALID.store(false, Ordering::Release);
+}
+
+pub(super) fn set_hash_metrics(legacy: u64, sqlite: u64, misses: u64, bytes: u64) {
+    METRICS_VALID.store(false, Ordering::Release);
+    LEGACY_HITS.store(legacy, Ordering::Relaxed);
+    SQLITE_HITS.store(sqlite, Ordering::Relaxed);
+    HASH_MISSES.store(misses, Ordering::Relaxed);
+    PENDING_BYTES.store(bytes, Ordering::Relaxed);
+    COMMITTED_FILES.store(0, Ordering::Relaxed);
+    COMMITTED_BATCHES.store(0, Ordering::Relaxed);
+    METRICS_VALID.store(true, Ordering::Release);
+}
+
+pub(super) fn live_metrics() -> Option<(u64, u64, u64, u64, u64, u64)> {
+    METRICS_VALID.load(Ordering::Acquire).then(|| (
+        LEGACY_HITS.load(Ordering::Relaxed),
+        SQLITE_HITS.load(Ordering::Relaxed),
+        HASH_MISSES.load(Ordering::Relaxed),
+        PENDING_BYTES.load(Ordering::Relaxed),
+        COMMITTED_FILES.load(Ordering::Relaxed),
+        COMMITTED_BATCHES.load(Ordering::Relaxed),
+    ))
+}
+
 fn database_path() -> Option<PathBuf> {
     get_config_cache_path().map(|p| p.cache_folder.join("duplicate_full_hash_checkpoints.sqlite3"))
 }
