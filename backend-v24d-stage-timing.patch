+// Stage changes are logged once per transition, never for each file-progress update.
+// Logging failure must never interfere with a scan.
+fn write_stage_event(event: &str, stage: &str, duration: Option<Duration>) {
+    let Some(root) = std::env::var_os("LOCALAPPDATA") else { return; };
+    let folder = PathBuf::from(root).join("KrokietClassic").join("logs");
+    if fs::create_dir_all(&folder).is_err() { return; }
+    let Ok(mut file) = OpenOptions::new().create(true).append(true).open(folder.join("scan_stages.log")) else { return; };
+    let time = Local::now().format("%Y-%m-%d %H:%M:%S%.3f");
+    let elapsed = duration.map(|d| format!(" duration_ms={}", d.as_millis())).unwrap_or_default();
+    let _ = writeln!(file, "{time}\t{event}\tstage={stage}{elapsed}");
