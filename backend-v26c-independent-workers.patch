+/// v2.6C: Metadata pools are independently configurable for slow/network drives.
+/// Stage-specific values take priority over the v2.6B compatibility setting.
+#[derive(Copy, Clone, Debug)]
+pub(crate) enum MetadataStage {
+    Traversal,
+    Hardlinks,
+}
+
+impl MetadataStage {
+    fn configuration(self) -> (&'static str, usize, &'static str) {
+        match self {
+            Self::Traversal => ("KROKIET_TRAVERSAL_WORKERS", 4, "traversal"),
+            Self::Hardlinks => ("KROKIET_HARDLINK_WORKERS", 2, "hardlink"),
+        }
+    }
+}
+
+fn parse_worker_count(name: &str) -> Option<usize> {
+    std::env::var(name)
         .ok()
         .and_then(|value| value.trim().parse::<usize>().ok())
         .filter(|&value| (1..=32).contains(&value))
-        .unwrap_or(4)
 }
 
-pub(crate) fn metadata_thread_pool() -> rayon::ThreadPool {
-    rayon::ThreadPoolBuilder::new()
-        .num_threads(metadata_worker_limit())
-        .thread_name(|index| format!("krokiet-metadata-{index}"))
-        .build()
-        .expect("unable to create scoped metadata worker pool")
+pub(crate) fn metadata_thread_pool(stage: MetadataStage) -> rayon::ThreadPool {
+    let (stage_key, default_workers, label) = stage.configuration();
+    let stage_override = parse_worker_count(stage_key);
+    let legacy_override = parse_worker_count("KROKIET_METADATA_WORKERS");
+    let (count, source) = if let Some(count) = stage_override {
+        (count, stage_key)
+    } else if let Some(count) = legacy_override {
+        (count, "KROKIET_METADATA_WORKERS")
+    } else {
+        (default_workers, "stage-default")
+    };
+    info!("NAS_DIAG_V26C {}_config requested_workers={} source={} default={}", label, count, source, default_workers);
+
+    let create = |workers| {
+        rayon::ThreadPoolBuilder::new()
+            .num_threads(workers)
+            .thread_name(move |index| format!("krokiet-{label}-{index}"))
+            .build()
+    };
+    match create(count) {
+        Ok(pool) => pool,
+        Err(error) => {
+            warn!("NAS_DIAG_V26C {}_pool_error workers={} error={}; trying single worker", label, count, error);
+            // If even this fails, retain the v2.6B fail-fast semantics.
+            create(1).expect("unable to create even a one-worker metadata thread pool")
+        }
+    }
+}
+
+#[cfg(test)]
+mod v26c_worker_config_tests {
+    use super::*;
+
+    #[test]
+    fn stage_defaults_are_distinct() {
+        assert_eq!(MetadataStage::Traversal.configuration().1, 4);
+        assert_eq!(MetadataStage::Hardlinks.configuration().1, 2);
+    }
+
+    #[test]
+    fn stage_environment_keys_are_distinct() {
+        assert_ne!(MetadataStage::Traversal.configuration().0, MetadataStage::Hardlinks.configuration().0);
+    }
 }
 
