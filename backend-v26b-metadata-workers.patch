 use crate::common::tool_data::CommonToolData;
 use crate::flc;
+
+/// v2.6B: Bound metadata-intensive Rayon work without changing the global pool.
+/// Set KROKIET_METADATA_WORKERS to 1..=32; default is 4.
+pub(crate) fn metadata_worker_limit() -> usize {
+    std::env::var("KROKIET_METADATA_WORKERS")
+        .ok()
+        .and_then(|value| value.trim().parse::<usize>().ok())
+        .filter(|&value| (1..=32).contains(&value))
+        .unwrap_or(4)
+}
+
+pub(crate) fn metadata_thread_pool() -> rayon::ThreadPool {
+    rayon::ThreadPoolBuilder::new()
+        .num_threads(metadata_worker_limit())
+        .thread_name(|index| format!("krokiet-metadata-{index}"))
+        .build()
+        .expect("unable to create scoped metadata worker pool")
+}
 
