+/// Record scan-level diagnostics beside the checkpoint database.
+/// Logging is best-effort and does not affect duplicate detection.
+pub(super) fn scan_event(event: &str, details: &str) {
+    if let Some(path) = database_path() {
+        if let Some(parent) = path.parent() {
+            if std::fs::create_dir_all(parent).is_ok() {
+                record_event(&path, event, details);
+            }
+        }
+    }
+}
