+//! Durable full-hash checkpoints for interrupted duplicate scans.
+//! A completed hash is committed in SQLite before becoming reusable in future scans.
+use std::path::PathBuf;
+use std::thread::{self, JoinHandle};
+use std::time::Duration;
+
+use crossbeam_channel::{Receiver, Sender, RecvTimeoutError, unbounded};
+use log::{info, warn};
+use rusqlite::{Connection, params};
+
+use crate::common::config_cache_path::get_config_cache_path;
+use crate::common::model::HashType;
+use crate::tools::duplicate::DuplicateEntry;
+
+fn database_path() -> Option<PathBuf> {
+    get_config_cache_path().map(|p| p.cache_folder.join("duplicate_full_hash_checkpoints.sqlite3"))
+}
+
+fn connect(path: &std::path::Path) -> rusqlite::Result<Connection> {
+    let conn = Connection::open(path)?;
+    conn.busy_timeout(Duration::from_secs(5))?;
+    conn.execute_batch("PRAGMA journal_mode=WAL;
+        PRAGMA synchronous=FULL;
+        CREATE TABLE IF NOT EXISTS hashes (
+            path TEXT NOT NULL,
+            algorithm TEXT NOT NULL,
+            size INTEGER NOT NULL,
+            modified INTEGER NOT NULL,
+            digest TEXT NOT NULL,
+            PRIMARY KEY(path, algorithm)
+        );")?;
+    Ok(conn)
+}
+
+fn commit_batch(conn: &mut Connection, batch: &mut Vec<DuplicateEntry>, algorithm: &str) -> rusqlite::Result<()> {
+    if batch.is_empty() { return Ok(()); }
+    let tx = conn.transaction()?;
+    {
+        let mut stmt = tx.prepare_cached("INSERT INTO hashes(path, algorithm, size, modified, digest)
+            VALUES (?1, ?2, ?3, ?4, ?5)
+            ON CONFLICT(path, algorithm) DO UPDATE SET
+            size=excluded.size, modified=excluded.modified, digest=excluded.digest")?;
+        for entry in batch.iter() {
+            stmt.execute(params![entry.path.to_string_lossy().as_ref(), algorithm,
+                entry.size as i64, entry.modified_date as i64, &entry.hash])?;
+        }
+    }
+    tx.commit()?;
+    batch.clear();
+    Ok(())
+}
+
+/// Checkpoints are optional: failure to open the database must not prevent a scan.
+pub(super) fn load(algorithm: HashType) -> Vec<DuplicateEntry> {
+    let Some(path) = database_path() else { return Vec::new(); };
+    if !path.exists() { return Vec::new(); }
+    let result = (|| -> rusqlite::Result<Vec<DuplicateEntry>> {
+        let conn = connect(&path)?;
+        let mut stmt = conn.prepare("SELECT path, size, modified, digest FROM hashes WHERE algorithm=?1")?;
+        let rows = stmt.query_map([format!("{algorithm:?}")], |r| {
+            Ok(DuplicateEntry {
+                path: PathBuf::from(r.get::<_, String>(0)?),
+                size: r.get::<_, i64>(1)? as u64,
+                modified_date: r.get::<_, i64>(2)? as u64,
+                hash: r.get(3)?,
+            })
+        })?;
+        rows.collect()
+    })();
+    match result {
+        Ok(entries) => { info!("Loaded {} completed hash checkpoints", entries.len()); entries }
+        Err(err) => { warn!("Cannot load full-hash checkpoints: {err}"); Vec::new() }
+    }
+}
+
+pub(super) struct CheckpointWriter {
+    tx: Sender<DuplicateEntry>,
+    handle: JoinHandle<()>,
+}
+
+impl CheckpointWriter {
+    pub(super) fn start(algorithm: HashType) -> Option<Self> {
+        let path = database_path()?;
+        if let Some(parent) = path.parent() {
+            if let Err(err) = std::fs::create_dir_all(parent) {
+                warn!("Cannot create checkpoint directory: {err}");
+                return None;
+            }
+        }
+        // Check creation synchronously to avoid silently losing checkpoints.
+        if let Err(err) = connect(&path) {
+            warn!("Cannot initialize checkpoint database: {err}");
+            return None;
+        }
+        let (tx, rx) = unbounded();
+        let handle = thread::spawn(move || write_loop(path, format!("{algorithm:?}"), rx));
+        Some(Self { tx, handle })
+    }
+
+    pub(super) fn sender(&self) -> Sender<DuplicateEntry> { self.tx.clone() }
+    pub(super) fn finish(self) {
+        drop(self.tx);
+        if self.handle.join().is_err() { warn!("Checkpoint writer thread panicked"); }
+    }
+}
+
+fn write_loop(path: PathBuf, algorithm: String, rx: Receiver<DuplicateEntry>) {
+    let Ok(mut conn) = connect(&path) else {
+        warn!("Cannot open checkpoint database for writing");
+        return;
+    };
+    let mut batch = Vec::with_capacity(64);
+    loop {
+        match rx.recv_timeout(Duration::from_secs(2)) {
+            Ok(entry) => batch.push(entry),
+            Err(RecvTimeoutError::Timeout) => {},
+            Err(RecvTimeoutError::Disconnected) => {
+                if let Err(err) = commit_batch(&mut conn, &mut batch, &algorithm) { warn!("Final checkpoint commit failed: {err}"); }
+                break;
+            }
+        }
+        if (batch.len() >= 64 || !batch.is_empty() && rx.is_empty())
+            && let Err(err) = commit_batch(&mut conn, &mut batch, &algorithm) {
+                warn!("Checkpoint commit failed: {err}");
+                batch.clear();
+            }
+    }
+}
+
+#[cfg(test)]
+mod tests {
+    use super::*;
+
+    #[test]
+    fn committed_hash_survives_database_reopen_and_invalidates_on_metadata_change() {
+        let dir = tempfile::tempdir().unwrap();
+        let path = dir.path().join("cache.sqlite3");
+        let item = DuplicateEntry { path: PathBuf::from("test_file.bin"), size: 123,
+            modified_date: 456, hash: "digest-abc".into() };
+        let mut conn = connect(&path).unwrap();
+        commit_batch(&mut conn, &mut vec![item.clone()], "Blake3").unwrap();
+        drop(conn);
+        let conn = connect(&path).unwrap();
+        let (size, modified, digest): (i64, i64, String) = conn.query_row(
+            "SELECT size, modified, digest FROM hashes WHERE path=?1 AND algorithm=?2",
+            params!["test_file.bin", "Blake3"], |r| Ok((r.get(0)?, r.get(1)?, r.get(2)?))).unwrap();
+        assert_eq!((size, modified, digest.as_str()), (123, 456, "digest-abc"));
+        assert_ne!(size as u64, 124); // a modified file must not reuse this cached result
+    }
+}
