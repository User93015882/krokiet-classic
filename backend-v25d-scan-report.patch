+fn format_precise_duration(duration: Duration) -> String {
+    if duration.as_secs() == 0 {
+        format!("{} ms", duration.as_millis())
+    } else {
+        format_duration(duration)
+    }
+}
+
 fn format_duration(duration: Duration) -> String {
     let seconds = duration.as_secs();
     format!("{:02}:{:02}:{:02}", seconds / 3600, (seconds / 60) % 60, seconds % 60)
@@ -129,3 +161,16 @@ fn write_stage_event(event: &str, stage: &str, duration: Option<Duration>) {
     let elapsed = duration.map(|d| format!(" duration_ms={}", d.as_millis())).unwrap_or_default();
     let _ = writeln!(file, "{time}\t{event}\tstage={stage}{elapsed}");
 }
+
+// Keep an independent report after the application closes. Writing is best-effort;
+// a failed diagnostic write must never change duplicate scan results.
+fn write_scan_report(started: &str, elapsed: Duration, cache: &str, commits: &str, history: &str) {
+    let Some(root) = std::env::var_os("LOCALAPPDATA") else { return; };
+    let folder = PathBuf::from(root).join("KrokietClassic").join("logs");
+    if fs::create_dir_all(&folder).is_err() { return; }
+    let report = format!(
+        "Krokiet Classic scan report\nStarted: {started}\nEnded: {}\nElapsed: {}\n{}\n{}\n\nStage history:\n{}\n",
+        Local::now().format("%Y-%m-%d %H:%M:%S"), format_duration(elapsed), cache, commits, history
+    );
+    let _ = fs::write(folder.join("last_scan_report.txt"), report);
+}
