+pub(crate) fn connect_progress_gathering(app: &MainWindow, progress_receiver: Receiver<ProgressData>) -> Timer {
+    // UI-only clocks. They do not affect the scanner or the checksum database.
+    let ui = app.as_weak();
+    let state = Rc::new(RefCell::new(None::<(Instant, Instant, String)>));
+    let timer = Timer::default();
+    timer.start(TimerMode::Repeated, Duration::from_secs(1), move || {
+        let Some(app) = ui.upgrade() else { return; };
+        let mut state = state.borrow_mut();
+        if !app.get_scanning() {
+            *state = None;
+            app.set_diagnostic_elapsed("00:00:00".into());
+            app.set_diagnostic_stage_elapsed("00:00:00".into());
+            return;
+        }
+        let now = Instant::now();
+        let current_stage = app.get_progress_datas().step_name.to_string();
+        let (scan_start, stage_start, previous_stage) = state.get_or_insert_with(|| (now, now, current_stage.clone()));
+        if *previous_stage != current_stage {
+            *stage_start = now;
+            *previous_stage = current_stage;
+        }
+        app.set_diagnostic_elapsed(format_duration(now.duration_since(*scan_start)).into());
+        app.set_diagnostic_stage_elapsed(format_duration(now.duration_since(*stage_start)).into());
+    });
