+/// v2.6D: Return aggregate identity-lookup timings without changing which files survive.
+/// Timings are cumulative across files and may exceed stage wall time under Rayon.
+#[derive(Default)]
+struct HardlinkIdentityProbe {
+    calls: u64,
+    high_res: u64,
+    other_or_error: u64,
+    same_id_skipped: u64,
+    duration_ns: u64,
+    slow_100ms: u64,
+    slow_1000ms: u64,
+}
+
 #[cfg(target_family = "windows")]
