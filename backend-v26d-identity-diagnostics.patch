+        let elapsed = started.elapsed();
+        let ns = elapsed.as_nanos().min(u64::MAX as u128) as u64;
+        probe.calls += 1;
+        probe.duration_ns = probe.duration_ns.saturating_add(ns);
+        probe.slow_100ms += u64::from(elapsed.as_millis() >= 100);
